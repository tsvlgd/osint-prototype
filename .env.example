# OSINT Framework Configuration
# Copy this file to .env and fill in your actual API credentials

# Serper.dev API Key
# Used for: Google Dorking (Social Discovery Phase - Step 1)
# Sign up: https://serper.dev
GOOGLE_API_KEY=your_serper_api_key_here

# GitHub Personal Access Token
# Used for: Repository search (Technical Infrastructure Phase - Step 3)
# Generate: https://github.com/settings/tokens
# Scopes needed: public_repo, read:user
GITHUB_TOKEN=your_github_token_here
